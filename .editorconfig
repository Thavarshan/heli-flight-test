root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,tex,bib}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

# Keep the vendored upstream class byte-for-byte unchanged.
[docs/paper/ieeeconf.cls]
end_of_line = crlf
insert_final_newline = false
trim_trailing_whitespace = false
indent_style = unset
indent_size = unset

[docs/paper/IEEEtran.bst]
end_of_line = crlf
insert_final_newline = false
trim_trailing_whitespace = false
indent_style = unset
indent_size = unset
